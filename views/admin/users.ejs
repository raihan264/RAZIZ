<%- include('../layouts/admin_header') %>

<h2>Users</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Joined</th>
        </tr>
    </thead>
    <tbody>
        <% users.forEach(user => { %>
            <tr>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
                <td><%= user.email %></td>
                <td><%= user.isAdmin ? 'Admin' : 'Member' %></td>
                <td><%= user.createdAt.toDateString() %></td>
            </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../layouts/admin_footer') %>

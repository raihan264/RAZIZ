<%- include('../layouts/admin_header') %>

<div class="row">
    <div class="col-md-12">
        <h2>System Settings</h2>
        <form action="/admin/settings" method="POST">
            <div class="card mb-3">
                <div class="card-header">Pterodactyl Configuration</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label>Panel URL</label>
                        <input type="url" name="ptero_url" class="form-control" value="<%= settings.ptero_url || '' %>" placeholder="https://panel.example.com" required>
                    </div>
                    <div class="mb-3">
                        <label>Application API Key (PLTA)</label>
                        <input type="text" name="ptero_app_key" class="form-control" value="<%= settings.ptero_app_key || '' %>" required>
                        <small class="text-muted">Used for creating servers and users.</small>
                    </div>
                    <div class="mb-3">
                        <label>Client API Key (PLTC)</label>
                        <input type="text" name="ptero_client_key" class="form-control" value="<%= settings.ptero_client_key || '' %>">
                        <small class="text-muted">Optional: Used for user-level actions if needed.</small>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">Store Configuration</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label>Admin WhatsApp Number</label>
                        <input type="text" name="admin_phone" class="form-control" value="<%= settings.admin_phone || '' %>" placeholder="628123456789">
                        <small class="text-muted">Orders will redirect here.</small>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Save Settings</button>
        </form>
    </div>
</div>

<%- include('../layouts/admin_footer') %>

<%- include('../layouts/admin_header') %>

<h2>Orders</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>User</th>
            <th>Product</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% orders.forEach(order => { %>
            <tr>
                <td><%= order.id %></td>
                <td><%= order.User ? order.User.username : 'Unknown' %></td>
                <td><%= order.Product ? order.Product.name : 'Unknown' %></td>
                <td>
                    <% if (order.status === 'pending') { %>
                        <span class="badge bg-warning">Pending</span>
                    <% } else if (order.status === 'active') { %>
                        <span class="badge bg-success">Active</span>
                    <% } else { %>
                        <span class="badge bg-danger">Expired</span>
                    <% } %>
                </td>
                <td><%= order.createdAt.toDateString() %></td>
                <td>
                    <% if (order.status === 'pending') { %>
                        <form action="/admin/orders/<%= order.id %>/approve" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success">Approve & Create</button>
                        </form>
                    <% } %>
                    <% if (order.status === 'active') { %>
                         <button class="btn btn-sm btn-secondary" disabled>Active</button>
                    <% } %>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../layouts/admin_footer') %>

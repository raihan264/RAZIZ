<%- include('../layouts/admin_header') %>

<h2>Add Product</h2>
<form action="/admin/products" method="POST">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label>Name</label>
            <input type="text" name="name" class="form-control" required>
        </div>
        <div class="col-md-6 mb-3">
            <label>Price</label>
            <input type="number" name="price" class="form-control" required>
        </div>
        <div class="col-md-4 mb-3">
            <label>Memory (MB)</label>
            <input type="number" name="memory" class="form-control" required>
        </div>
        <div class="col-md-4 mb-3">
            <label>Disk (MB)</label>
            <input type="number" name="disk" class="form-control" required>
        </div>
        <div class="col-md-4 mb-3">
            <label>CPU (%)</label>
            <input type="number" name="cpu" class="form-control" required>
        </div>
        <div class="col-md-6 mb-3">
            <label>Nest ID</label>
            <input type="number" name="nest_id" class="form-control" required>
        </div>
        <div class="col-md-6 mb-3">
            <label>Egg ID</label>
            <input type="number" name="egg_id" class="form-control" required>
        </div>
        <div class="col-md-12 mb-3">
            <label>Startup Command</label>
            <input type="text" name="startup" class="form-control" value="java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar server.jar">
        </div>
        <div class="col-md-12 mb-3">
            <label>Docker Image</label>
            <input type="text" name="docker_image" class="form-control" value="ghcr.io/pterodactyl/yolks:java_17">
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Create Product</button>
</form>

<%- include('../layouts/admin_footer') %>

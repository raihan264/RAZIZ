<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">PteroStore</a>
            <div class="navbar-nav ms-auto">
                <% if (user) { %>
                    <a class="nav-link" href="/dashboard">Dashboard</a>
                    <% if (user.isAdmin) { %>
                        <a class="nav-link" href="/admin/dashboard">Admin</a>
                    <% } %>
                    <a class="nav-link" href="/logout">Logout</a>
                <% } else { %>
                    <a class="nav-link" href="/login">Login</a>
                    <a class="nav-link" href="/register">Register</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <h1>Welcome to PteroStore</h1>
        <p>Premium Game Hosting</p>

        <!-- Products will go here later -->
        <div class="row">
            <% if (typeof products !== 'undefined') { %>
                <% products.forEach(product => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title"><%= product.name %></h5>
                                <p class="card-text">
                                    RAM: <%= product.memory %> MB<br>
                                    CPU: <%= product.cpu %> %<br>
                                    Disk: <%= product.disk %> MB
                                </p>
                                <a href="/product/<%= product.id %>" class="btn btn-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</body>
</html>

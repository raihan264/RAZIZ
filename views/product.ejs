<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= product.name %> - Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">PteroStore</a>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="row">
            <div class="col-md-6">
                <!-- Placeholder image -->
                <div class="bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 300px;">
                    <h3>Server Icon</h3>
                </div>
            </div>
            <div class="col-md-6">
                <h2><%= product.name %></h2>
                <h3 class="text-primary">Rp <%= product.price %></h3>
                <hr>
                <h5>Specifications:</h5>
                <ul>
                    <li><strong>RAM:</strong> <%= product.memory %> MB</li>
                    <li><strong>Disk:</strong> <%= product.disk %> MB</li>
                    <li><strong>CPU:</strong> <%= product.cpu %> %</li>
                    <li><strong>Databases:</strong> 1</li>
                    <li><strong>Backups:</strong> 1</li>
                </ul>
                <div class="alert alert-info">
                    <strong>Note:</strong> 15 Days Warranty included.
                </div>

                <form action="/order/<%= product.id %>" method="POST">
                    <button type="submit" class="btn btn-lg btn-success w-100">Buy Now</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
